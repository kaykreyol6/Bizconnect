# Copy to .env (never commit real secrets).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Leave empty to use SQLite at SQLITE_FILE; set to use PostgreSQL (required for production / multiple instances).
DATABASE_URL=
SQLITE_FILE=./data/bizconnect.sqlite
DB_POOL_MAX=10

# Required in production, >= 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL_SECONDS=604800
BCRYPT_ROUNDS=11

# Comma-separated origins allowed to call the API cross-origin (e.g. a separate mobile web app).
CORS_ORIGINS=
# Number of proxy hops to trust for client IPs (1 behind a single load balancer).
TRUST_PROXY=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# Defaults: auto-migrate + seed demo data in development only.
AUTO_MIGRATE=
SEED_DEMO=
